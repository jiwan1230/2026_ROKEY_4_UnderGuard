MONITOR_MODE=mock
SECRET_KEY=change-this-before-demo
DATABASE_PATH=system_monitor.db
ROBOT_NAMESPACES=robot4,robot5
ROBOT_ROLES=SCOUT,SCOUT
OFFLINE_TIMEOUT_SEC=3.0
POLL_INTERVAL_MS=1000
TARGET_LOSS_TIMEOUT_SEC=1.5
LOW_BATTERY_THRESHOLD=15.0
MAP_YAML_PATH=../minipjt/mini_turtle4/resource/my_map.yaml

# 내일 로봇 저장소 확인 후 아래 값만 실제 인터페이스에 맞춘다.
# 상대 이름은 각 ROBOT_NAMESPACES 아래에 붙고, 절대 이름은 그대로 사용한다.
# 예: odom 또는 /{namespace}/odometry/filtered
ROS_WEBCAM_DETECTIONS_TOPIC=webcam/detections
ROS_OAKD_DETECTIONS_TOPIC=oakd/detections
ROS_ODOMETRY_TOPIC=odom
ROS_BATTERY_TOPIC=battery_state
ROS_MAP_FRAME=map
