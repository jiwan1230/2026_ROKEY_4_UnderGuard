MONITOR_MODE=mock
ROBOT_NAMESPACES=robot4,robot6
ROBOT_ROLES=SCOUT,SCOUT
# main robot_agent의 battery_check_period/status 보고 기본값은 10초다.
OFFLINE_TIMEOUT_SEC=15.0
POLL_INTERVAL_MS=1000
TARGET_LOSS_TIMEOUT_SEC=1.5
LOW_BATTERY_THRESHOLD=15.0
# 이 파일이 있는 Sysmon/backend/를 기준(run_mock.sh/run_ros.sh가 cd하는 곳)으로 상대경로다.
# room_map.yaml은 main의 robot_bringup.launch.py와 쥐몰이 알고리즘이 참조하는
# 현재 맵이다(2026-08-06 실측). 예전 mini 프로젝트의 my_map.yaml은 좌표계가
# 달라(origin 등) 대체했다.
MAP_YAML_PATH=../../../minipjt/mini_turtle4/resource/room_map.yaml

# main의 Fleet String 읽기 전용 인터페이스다.
ROS_FLEET_STATUS_TOPIC=/fleet/status
ROS_FLEET_EVENT_TOPIC=/fleet/event
# /fleet/event에 없는 robot_id·confidence가 실려 오는 상세 탐지 토픽이다.
ROS_FLEET_DETECTION_TOPIC=/fleet/detection
# db_node의 기록 조회 서비스. MySQL에 직접 붙지 않고 이 서비스만 거친다.
ROS_DB_QUERY_SERVICE=/db/query

# 로봇별 보조 센서 입력. 상대 이름은 ROBOT_NAMESPACES 아래에 붙는다.
# 예: odom 또는 /{namespace}/odometry/filtered
ROS_WEBCAM_DETECTIONS_TOPIC=webcam/detections
ROS_OAKD_DETECTIONS_TOPIC=oakd/detections
ROS_ODOMETRY_TOPIC=odom
ROS_BATTERY_TOPIC=battery_state
# OAK-D 원본 압축 프레임. 예전 camera_node의 synced/rgb는 detector_node에
# 통합·삭제되어 더 이상 발행되지 않는다.
ROS_CAMERA_FRAME_TOPIC=oakd/rgb/image_raw/compressed
ROS_MAP_FRAME=map
