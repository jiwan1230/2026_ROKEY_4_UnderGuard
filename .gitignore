# ROS 2 워크스페이스 산출물 — 우리 소스(src/turtle_project, src/turtle_interfaces)만 추적한다.
/build/
/install/
/log/

# 워크스페이스 루트 잡동사니 (모델·homography 등 대용량 바이너리)
/*.pt
/*.npy
*.db

# src 안에서 우리 패키지 2개만 남기고 나머지 워크스페이스 패키지 제외
/src/*
!/src/turtle_project/
!/src/turtle_interfaces/


# 파이썬/빌드 산출물
__pycache__/
*.pyc
diagrams/


# TensorRT 엔진 — 143MB+, GitHub 100MB 한계 초과 + GPU/버전 종속이라 PC마다 다시 빌드해야 함
src/turtle_project/resource/best.engine
*.engine

# 실험 렌더링 산출물 — 시뮬레이터 물리 모델이 바뀌면 즉시 낡아서, 커밋해두면
# 나중에 잘못된 결과를 발표에 쓰게 된다. 필요할 때 experiments/pincer_demo.py로
# 다시 뽑는다.
intelligence1_algorithm/herding_controller_dual/experiments/media/
