          <mxGeometry x="930" y="485" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="02-e27" value="/fleet/event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=0;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v21" target="02-v22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-e28" value="TRACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=0;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v22" target="02-v23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-e29" value="HERD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=0;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v22" target="02-v24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-e30" value="tracking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=0;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v23" target="02-v25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-e31" value="captured/lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=0;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v25" target="02-v26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-v32" value="&lt;b&gt;문제 1&lt;/b&gt;&lt;br&gt;B는 보통 DOCKED인데 HERD 전에 UNDOCK이 없다.&lt;br&gt;RatHerding event_cb도 goal 계산 없이 로그만 남긴다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;dashed=0;" vertex="1" parent="02-1">
          <mxGeometry x="930" y="660" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="02-v33" value="&lt;b&gt;문제 2&lt;/b&gt;&lt;br&gt;Detector command_cb가 robot 필드를 버려 robot4 TRACK에 robot6 detector도 켜진다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;dashed=0;" vertex="1" parent="02-1">
          <mxGeometry x="1330" y="660" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="02-v34" value="&lt;b&gt;문제 3·5&lt;/b&gt;&lt;br&gt;UNDOCK 전에 PATROLLING 보고. dock 실패도 DOCKED 가능.&lt;br&gt;TRACK reset 후 재관측 0회면 rat_lost 없음." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;dashed=0;" vertex="1" parent="02-1">
          <mxGeometry x="930" y="810" width="780" height="115" as="geometry" />
        </mxCell>
        <mxCell id="02-v35" value="&lt;b&gt;vNext 설계 요약&lt;/b&gt;&lt;br&gt;Central pending_after_undock: DOCKED B → UNDOCK → IDLE 확인 → HERD&lt;br&gt;Detector는 namespace robot_id 필터 · RatTracker tracking_started_at 추가&lt;br&gt;RatObservation typed topic + 실제 B_goal = rat 반대편 standoff 계산" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;dashed=1;" vertex="1" parent="02-1">
          <mxGeometry x="260" y="760" width="600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="02-e36" value="개선 설계" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v32" target="02-v35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="02-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;fontSize=11;fontColor=#2563eb;labelBackgroundColor=#ffffff;" edge="1" parent="02-1" source="02-v33" target="02-v35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
