          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x4redIiIMa9jU7bzmFlu-3" edge="1" parent="1" source="Bt-omwzy2xqqBgIjLX3l-1" target="x4redIiIMa9jU7bzmFlu-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" value="SEARCHING 이면">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-rat-ev" edge="1" parent="1" source="x4redIiIMa9jU7bzmFlu-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#FF0000;strokeWidth=3;fontSize=18;labelBackgroundColor=#ffffff;" value="&lt;b&gt;/fleet/event&lt;br&gt;&apos;rat_detected:x:y&apos;&lt;/b&gt;&lt;br&gt;(tracking=False 일 때)">
          <mxGeometry relative="1" x="0.72" as="geometry"><mxPoint as="offset" /><Array as="points"><mxPoint x="-1220" y="3685" /><mxPoint x="-1220" y="1190" /><mxPoint x="320" y="1190" /></Array><mxPoint x="320" y="1240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sDo877fp-fzKSNCjQill-11" edge="1" parent="1" source="sDo877fp-fzKSNCjQill-6" target="Bt1_jshHilU3t0fcEZmU-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" value="no → 처음 본 셈 치고 검증">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= detector 상태기계 패널 ================= -->
        <mxCell id="cl-dsm" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#2563eb;strokeWidth=3;fontSize=30;fontStyle=1;align=center;verticalAlign=top;spacingTop=12;" value="detector_node opening 상태기계 — 6 state">
          <mxGeometry height="1850" width="1040" x="-390" y="4430" as="geometry" />
        </mxCell>
        <mxCell id="cl-s-search" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2563eb;strokeWidth=3;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="SEARCHING">
          <mxGeometry height="60" width="280" x="110" y="4500" as="geometry" />
        </mxCell>
        <mxCell id="cl-a-appr" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="opening 감지 → _box_to_map → &lt;b&gt;_start_approach&lt;/b&gt;: 구멍 앞 0.5m 지점을 target_pose 로 발행 + patrol_hold=True (순찰 정지) + self.goal 저장">
          <mxGeometry height="80" width="800" x="-330" y="4590" as="geometry" />
        </mxCell>
        <mxCell id="cl-s-appr" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2563eb;strokeWidth=3;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="APPROACHING">
          <mxGeometry height="60" width="280" x="110" y="4700" as="geometry" />
        </mxCell>
        <mxCell id="cl-d-arr" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" value="&lt;b&gt;_check_arrival&lt;/b&gt; (매 프레임)&lt;br&gt;hypot(goal − TF base_link) ≤ &lt;b&gt;arrive_tol 0.3m&lt;/b&gt; ?">
          <mxGeometry height="120" width="480" x="-20" y="4790" as="geometry" />
        </mxCell>
        <mxCell id="cl-w-arr" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;🟡 도착 신호가 없다&lt;/b&gt;&lt;br&gt;주행은 robot_agent 가 하고 Nav2 완료 콜백은 여기로 안 온다 — TF 거리로 &lt;b&gt;스스로 폴링&lt;/b&gt;&lt;br&gt;· Nav2 ABORT 를 못 받아 60s watchdog 으로만 탈출&lt;br&gt;· arrive_tol 0.3m 이 Nav2 xy_goal_tolerance 와 암묵 커플링">
          <mxGeometry height="150" width="310" x="-370" y="4780" as="geometry" />
        </mxCell>
        <mxCell id="cl-s-query" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2563eb;strokeWidth=3;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="QUERYING">
          <mxGeometry height="60" width="280" x="110" y="4940" as="geometry" />
        </mxCell>
        <mxCell id="cl-a-query" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_request_db&lt;/b&gt; — 감지 좌표(self.target)로 &lt;b&gt;/db/query_hole&lt;/b&gt; call_async → _db_done 콜백. 서비스 미기동이면 QUERYING 안 들어가고 즉시 검증으로.">
          <mxGeometry height="70" width="800" x="-330" y="5030" as="geometry" />
        </mxCell>
        <mxCell id="cl-d-exists" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" value="&lt;b&gt;resp.exists ?&lt;/b&gt;&lt;br&gt;db_node: nearest ≤ hole_match_dist 0.3m">
          <mxGeometry height="120" width="480" x="-20" y="5130" as="geometry" />
        </mxCell>
        <mxCell id="cl-s-verify" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2563eb;strokeWidth=3;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="VERIFYING&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;처음 본 구멍&lt;/font&gt;">
          <mxGeometry height="60" width="280" x="-350" y="5290" as="geometry" />
        </mxCell>
        <mxCell id="cl-s-inspect" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2563eb;strokeWidth=3;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="INSPECTING&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;기존 구멍 점검&lt;/font&gt;">
          <mxGeometry height="60" width="280" x="250" y="5290" as="geometry" />
        </mxCell>
        <mxCell id="cl-a-verify" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_verify — 진짜 구멍인가&lt;/b&gt; 🟢&lt;br&gt;side_px(side_margin 0.05m, z, fx) 만큼 bbox 를 좌우로 넓혀 옆 벽까지 포함&lt;br&gt;&lt;b&gt;depth_spread = p90 − p10 ≥ depth_gap 0.05m ?&lt;/b&gt;&lt;br&gt;구멍이면 안쪽(멀다)+테두리(가깝다)가 섞여 편차 큼&lt;br&gt;미달 → 순찰 재개 / 재검출·유효픽셀 실패 30프레임 → 포기">
          <mxGeometry height="150" width="340" x="-370" y="5380" as="geometry" />
        </mxCell>
        <mxCell id="cl-a-inspect" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_inspect — trap 이 제대로 놓였나&lt;/b&gt; 🟢&lt;br&gt;trap 박스 → _box_to_map 으로 trap 좌표&lt;br&gt;&lt;b&gt;TrapJob(phase=&apos;inspect&apos;, hole, trap)&lt;/b&gt; 발행&lt;br&gt;→ 판정은 trap_check 가 (거리 ≤ 0.15m)&lt;br&gt;30프레임 미검출 → 아직 안 놓인 것으로 보고 _reinstall">
          <mxGeometry height="150" width="340" x="230" y="5380" as="geometry" />
        </mxCell>
        <mxCell id="cl-a-conf" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;gap ≥ 0.05m → 진짜 opening&lt;/b&gt;&lt;br&gt;/fleet/event &lt;b&gt;opening_confirmed:x:y&lt;/b&gt; (db_node 가 저장)&lt;br&gt;self.hole = target, reinstall_count = 0&lt;br&gt;&lt;b&gt;TrapJob(phase=&apos;install&apos;)&lt;/b&gt; 발행 — 최초 설치는 재설치 카운트에 안 넣음">
          <mxGeometry height="130" width="340" x="-370" y="5550" as="geometry" />
        </mxCell>
        <mxCell id="cl-s-await" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaf7;strokeColor=#2563eb;strokeWidth=3;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="AWAIT_TRAP">
          <mxGeometry height="60" width="280" x="110" y="5700" as="geometry" />
        </mxCell>
        <mxCell id="cl-a-await" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;trap_event_cb — /fleet/event 이름으로 분기 (AWAIT_TRAP 일 때만)&lt;/b&gt; 🟢&lt;br&gt;&lt;b&gt;trap_installed&lt;/b&gt; → INSPECTING (설치동작 끝 — 15cm 기준으로 다시 본다)&lt;br&gt;&lt;b&gt;trap_ok&lt;/b&gt; → _finish_opening : patrol_hold=False, 상태 초기화, SEARCHING 복귀&lt;br&gt;&lt;b&gt;trap_bad / 미검출&lt;/b&gt; → _reinstall : install job 재발행, &lt;b&gt;reinstall_max 3&lt;/b&gt; 초과 시 경고 후 순찰 재개">
          <mxGeometry height="140" width="1000" x="-370" y="5790" as="geometry" />
        </mxCell>
        <mxCell id="cl-wd" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;watchdog_tick (1 s) — 영구 대기 방지&lt;/b&gt;&lt;br&gt;상태가 바뀌면 시계 리셋, 한도를 넘기면 탈출한다.&lt;br&gt;&lt;br&gt;APPROACHING 60s · &lt;b&gt;QUERYING 5s&lt;/b&gt; · VERIFYING 30s&lt;br&gt;INSPECTING 30s · AWAIT_TRAP 20s&lt;br&gt;&lt;br&gt;QUERYING timeout → &lt;b&gt;verify&lt;/b&gt; (db 무응답 = 처음 본 셈)&lt;br&gt;나머지 timeout → &lt;b&gt;finish&lt;/b&gt; (opening 포기, 순찰 재개)&lt;br&gt;&lt;br&gt;비-SEARCHING 동안 &lt;b&gt;patrol_hold=True 재발행(heartbeat)&lt;/b&gt;&lt;br&gt;→ detector 가 죽으면 agent 가 lease 만료로 자동 순찰 재개">
          <mxGeometry height="310" width="480" x="-370" y="5950" as="geometry" />
        </mxCell>
        <mxCell id="cl-ratp" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;rat 경로 — 위 상태기계와 독립 (매 프레임)&lt;/b&gt; 🟢&lt;br&gt;&lt;br&gt;&lt;b&gt;tracking = False&lt;/b&gt; (순찰 중 우연히 봄)&lt;br&gt;→ /fleet/event &lt;b&gt;rat_detected&lt;/b&gt; 만 발행, central 이 역할배정 시작&lt;br&gt;&lt;br&gt;&lt;b&gt;tracking = True&lt;/b&gt; (central 이 TRACK 배정)&lt;br&gt;→ 쥐 위치로 target_pose 를 &lt;b&gt;rat_goal_period 1 s&lt;/b&gt; 마다 재발행&lt;br&gt;&amp;nbsp;&amp;nbsp;(매 프레임 쏘면 Nav2 goal 폭주)&lt;br&gt;→ RatTracker: 0.3m 반경 &lt;b&gt;10 s 체류 = 포획&lt;/b&gt; → rat_captured&lt;br&gt;→ lost_tick(1s): &lt;b&gt;5 s 미검출 = 놓침&lt;/b&gt; → rat_lost&lt;br&gt;&lt;br&gt;&lt;i&gt;좌표가 떨리므로 &apos;정확히 같음&apos; 이 아니라 반경으로 판정&lt;/i&gt;">
          <mxGeometry height="310" width="480" x="150" y="5950" as="geometry" />
        </mxCell>
        <mxCell id="cl-e-s1" edge="1" parent="1" source="cl-s-search" target="cl-a-appr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;fontSize=13;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-e-s2" edge="1" parent="1" source="cl-a-appr" target="cl-s-appr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
