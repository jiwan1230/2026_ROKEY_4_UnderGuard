        <mxCell id="cl-e-s6" edge="1" parent="1" source="cl-a-query" target="cl-d-exists" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;">
