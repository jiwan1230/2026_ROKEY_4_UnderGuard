        <mxCell id="cl-e-s5" edge="1" parent="1" source="cl-s-query" target="cl-a-query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;">
