          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="5860" /><mxPoint x="700" y="4530" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="cl-e-s16" edge="1" parent="1" source="cl-a-await" target="cl-s-inspect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#bf9000;fontColor=#bf9000;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="trap_installed → 15cm 재점검">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-420" y="5860" /><mxPoint x="-420" y="5320" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="cl-e-into-dsm" edge="1" parent="1" source="x4redIiIMa9jU7bzmFlu-2" target="cl-s-appr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;fontColor=#2563eb;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="state = APPROACHING">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-450" y="4050" /><mxPoint x="-450" y="4380" /><mxPoint x="20" y="4380" /><mxPoint x="20" y="4730" /></Array></mxGeometry>
        </mxCell>

        <!-- ================= robot_agent ================= -->
        <mxCell id="ZesqVsjJ1KR3q78cPR1M-5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#e69138;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;robot_agent — 로봇 1대 제어&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 18px; font-weight: normal;&quot;&gt;로봇당 Nav2 주인 1개 · 모든 goal 주행이 여기로 모인다&lt;/span&gt;">
          <mxGeometry height="1570" width="805" x="-1218" y="4570" as="geometry" />
        </mxCell>
        <mxCell id="fkapCajKWG6HI9sVUpWm-5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=3;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;target_cb — target_pose 수신 (★ 단일 진입구)&lt;/b&gt; 🟢&lt;br&gt;detector 접근·추적 / trap_check 설치 / rat_herding 몰이 goal 공용&lt;br&gt;dock_phase ≠ None 이면 &lt;b&gt;무시&lt;/b&gt; (도크 이동과 충돌 방지)&lt;br&gt;nav.goToPose(msg) — 새 goal 이 이전 goal 을 &lt;b&gt;선점(preempt)&lt;/b&gt; 해 목표가 움직여도 계속 따라간다">
          <mxGeometry height="130" width="760" x="-1195" y="4680" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-cmd" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;command_cb — /fleet/command 에서 자기(ns) 명령만&lt;/b&gt; 🟢&lt;br&gt;&lt;b&gt;UNDOCK&lt;/b&gt; → UNDOCKING · after_undock=&apos;PATROL&apos; · start_undocking&lt;br&gt;&lt;b&gt;PATROL&lt;/b&gt; → start_patrol (이미 필드 위)&lt;br&gt;&lt;b&gt;DOCK&lt;/b&gt; → RETURNING · start_docking (언도킹 중이면 완료 후로 예약)&lt;br&gt;&lt;b&gt;TRACK / HERD&lt;/b&gt; → stop_patrol · 도킹 중이었으면 먼저 언도킹 후 goal 대기&lt;br&gt;&lt;b&gt;STOP&lt;/b&gt; → IDLE · stop_patrol">
          <mxGeometry height="190" width="760" x="-1195" y="4830" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-tick" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;patrol_tick (1 s 폴링)&lt;/b&gt; 🟢&lt;br&gt;① &lt;b&gt;hold lease&lt;/b&gt; — 마지막 hold=True 로부터 &lt;b&gt;hold_lease_sec 3s&lt;/b&gt; 초과 시 자동 해제 후 순찰 재개 (detector 사망 대비)&lt;br&gt;② dock_phase 있으면 _dock_tick 으로 넘기고 리턴&lt;br&gt;③ isTaskComplete → CANCELED 면 순찰 종료, 그 외엔 _send_lap (다음 바퀴 = 무한 순찰)">
          <mxGeometry height="160" width="760" x="-1195" y="5040" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-dock" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_dock_tick — 논블로킹 도킹/언도킹 단계 진행&lt;/b&gt; 🟢&lt;br&gt;dock()/undock() 이 블로킹이라 콜백에서 직접 못 부른다 → 완료 여부만 폴링해 단계를 넘긴다&lt;br&gt;&lt;b&gt;NAV&lt;/b&gt;: 도크앞 goToPose 완료 → dock_send_goal (실패해도 근처면 붙을 수 있어 시도)&lt;br&gt;&lt;b&gt;DOCK&lt;/b&gt;: isDockComplete + &lt;b&gt;nav.is_docked 센서 확인&lt;/b&gt; → DOCKED / 실패면 IDLE&lt;br&gt;&lt;b&gt;UNDOCK&lt;/b&gt;: isUndockComplete → after_undock 이 PATROL·DOCK·None 중 무엇인지로 분기">
          <mxGeometry height="180" width="760" x="-1195" y="5220" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-hold" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;hold_cb — patrol_hold&lt;/b&gt; 🟢&lt;br&gt;detector 가 opening 처리 시작/끝을 알린다&lt;br&gt;False→True 전이: stop_patrol&lt;br&gt;True→False 전이: 순찰 재개&lt;br&gt;수신할 때마다 hold_at 갱신 (lease 유지)">
          <mxGeometry height="140" width="370" x="-1195" y="5420" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-batt" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;battery_cb — battery_state&lt;/b&gt; 🟢&lt;br&gt;percentage 가 NaN 이면 무시&lt;br&gt;0~1 스케일이면 ×100 정규화&lt;br&gt;&lt;b&gt;&amp;lt; battery_threshold 40&lt;/b&gt; 이고 PATROLLING 이면&lt;br&gt;→ RETURNING + start_docking">
          <mxGeometry height="140" width="370" x="-805" y="5420" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-report" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;report (10 s)&lt;/b&gt; 🟢&lt;br&gt;/fleet/status ← &quot;ns:state:battery&quot;&lt;br&gt;central 이 이것만 보고 조율한다">
          <mxGeometry height="110" width="370" x="-1195" y="5580" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-rule" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;상태 방송 규칙&lt;/b&gt;&lt;br&gt;DOCKED 는 _dock_tick 에서만&lt;br&gt;PATROLLING 은 _send_lap 에서만&lt;br&gt;&lt;i&gt;성공 전에 방송하면 central 이 교대·커버리지를 잘못 판단한다&lt;/i&gt;">
          <mxGeometry height="110" width="370" x="-805" y="5580" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-warn" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;🟡 target_pose goal 의 결과를 아무도 폴링하지 않는다&lt;/b&gt;&lt;br&gt;patrol_tick 의 isTaskComplete 검사는 self.patrolling 가드에 막혀 target goal 에는 안 돈다 → Nav2 가 ABORT 해도 detector·trap_check 는 통보를 못 받는다.">
          <mxGeometry height="120" width="760" x="-1195" y="5710" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-io" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddebf7;strokeColor=#5b9bd5;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;입출력 정리&lt;/b&gt;&lt;br&gt;SUB: /fleet/command · battery_state · target_pose · patrol_hold&lt;br&gt;PUB: /fleet/status&lt;br&gt;ACTION(TurtleBot4Navigator, /{ns} 네임스페이스): FollowWaypoints · NavigateToPose · Dock · Undock&lt;br&gt;&lt;i&gt;nav 도 자체 노드라 main 에서 같은 SingleThreadedExecutor 에 add_node — 안 그러면 피드백이 처리되지 않는다&lt;/i&gt;">
          <mxGeometry height="170" width="760" x="-1195" y="5850" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-e1" edge="1" parent="1" source="fkapCajKWG6HI9sVUpWm-5" target="cl-ra-cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#e69138;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-e2" edge="1" parent="1" source="cl-ra-cmd" target="cl-ra-tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#e69138;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-ra-e3" edge="1" parent="1" source="cl-ra-tick" target="cl-ra-dock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#e69138;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" value="dock_phase 있으면">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sDo877fp-fzKSNCjQill-2" edge="1" parent="1" source="x4redIiIMa9jU7bzmFlu-2" target="fkapCajKWG6HI9sVUpWm-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#cc0000;strokeWidth=4;fontSize=18;fontColor=#cc0000;labelBackgroundColor=#ffffff;" value="&lt;b&gt;target_pose&lt;/b&gt;&lt;br&gt;PoseStamped (map)">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-1100" y="4050" /><mxPoint x="-1100" y="4640" /><mxPoint x="-815" y="4640" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="cl-hold-edge" edge="1" parent="1" source="cl-wd" target="cl-ra-hold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#bf9000;strokeWidth=3;fontSize=14;fontColor=#bf9000;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;patrol_hold&lt;/b&gt; (Bool, 1s heartbeat)">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-400" y="6105" /><mxPoint x="-400" y="5490" /></Array></mxGeometry>
        </mxCell>

        <!-- ================= db_node ================= -->
        <mxCell id="Bt1_jshHilU3t0fcEZmU-1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#e69138;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;font style=&quot;font-size: 48px; font-weight: normal;&quot;&gt;db_node&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;중앙 PC · 구멍/trap 좌표 영속 저장&lt;/font&gt;">
          <mxGeometry height="1570" width="805" x="670" y="2590" as="geometry" />
        </mxCell>
        <mxCell id="cl-db-sqlite" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;SQLite (db_path, 기본 holes.db)&lt;/b&gt; 🟢&lt;br&gt;CREATE TABLE IF NOT EXISTS &lt;b&gt;holes(id, x, y, trap_installed)&lt;/b&gt;&lt;br&gt;재시작해도 구멍이 남는다&lt;br&gt;&lt;i&gt;콜백은 단일 스레드지만 sqlite 기본 소유 검사를 꺼서(check_same_thread=False) 쓴다&lt;/i&gt;">
          <mxGeometry height="150" width="760" x="690" y="2700" as="geometry" />
        </mxCell>
        <mxCell id="cl-db-near" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;nearest(holes, x, y) → (idx, 거리)&lt;/b&gt; 🟢&lt;br&gt;&lt;b&gt;hole_match_dist 0.3 m&lt;/b&gt; — &apos;같은 구멍인가&apos; 를 정하는 유일한 기준&lt;br&gt;좌표 추정값이 떨리므로 &apos;정확히 같음&apos; 대신 반경으로 판정&lt;br&gt;저장·조회·갱신 세 경로가 모두 이 함수를 지난다">
          <mxGeometry height="140" width="760" x="690" y="2880" as="geometry" />
        </mxCell>
        <mxCell id="sDo877fp-fzKSNCjQill-3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;query() — /db/query_hole 서비스&lt;/b&gt; 🟢&lt;br&gt;nearest ≤ 0.3m 이면&lt;br&gt;exists=True + trap_installed + &lt;b&gt;저장 좌표(hole_x, hole_y)&lt;/b&gt;&lt;br&gt;아니면 exists=False&lt;br&gt;&lt;i&gt;저장좌표를 돌려줘야 trap_check 가 15cm 점검을 한다&lt;/i&gt;">
          <mxGeometry height="160" width="500" x="820" y="3060" as="geometry" />
        </mxCell>
        <mxCell id="cl-db-store" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;event_cb — /fleet/event 구독&lt;/b&gt; 🟢&lt;br&gt;&lt;b&gt;opening_confirmed&lt;/b&gt; → _store_hole : nearest ≤ 0.3m 면 스킵, 아니면 INSERT&lt;br&gt;&lt;b&gt;trap_ok&lt;/b&gt; → UPDATE trap_installed = 1&lt;br&gt;&lt;b&gt;trap_bad&lt;/b&gt; → UPDATE trap_installed = 0&lt;br&gt;&lt;i&gt;아는 구멍이 아니면 갱신 무시&lt;/i&gt;">
          <mxGeometry height="180" width="760" x="690" y="3270" as="geometry" />
        </mxCell>
        <mxCell id="cl-db-note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddebf7;strokeColor=#5b9bd5;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="UI(system_monitor)는 이 DB 를 직접 안 보고 /fleet/event 를 자체 구독한다 — db_node 는 UI 용 발행을 하지 않는다.">
          <mxGeometry height="110" width="760" x="690" y="3480" as="geometry" />
        </mxCell>
        <mxCell id="cl-db-warn" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;🟡 db_node 가 없어도 시스템은 돈다&lt;/b&gt;&lt;br&gt;detector 는 서비스 미기동이면 즉시 VERIFYING, 응답이 5s 넘게 없으면 watchdog 이 &apos;처음 본 구멍&apos; 으로 간주하고 검증으로 진행한다 → 기존 구멍을 매번 새로 검증하게 된다.">
          <mxGeometry height="130" width="760" x="690" y="3620" as="geometry" />
        </mxCell>
        <mxCell id="sDo877fp-fzKSNCjQill-4" edge="1" parent="1" source="sDo877fp-fzKSNCjQill-6" target="sDo877fp-fzKSNCjQill-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;fontSize=17;labelBackgroundColor=#ffffff;" value="&lt;b&gt;yes&lt;/b&gt; — /db/query_hole (QueryHole srv)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sDo877fp-fzKSNCjQill-10" edge="1" parent="1" source="sDo877fp-fzKSNCjQill-3" target="Bt1_jshHilU3t0fcEZmU-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;fontSize=17;labelBackgroundColor=#ffffff;" value="응답 (exists, hole_x, hole_y)">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="4230" /><mxPoint x="120" y="4230" /><mxPoint x="120" y="4080" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="cl-db-in" edge="1" parent="1" source="cl-a-conf" target="cl-db-store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#38761d;fontColor=#38761d;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;/fleet/event opening_confirmed&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="5615" /><mxPoint x="600" y="3360" /></Array></mxGeometry>
        </mxCell>

        <!-- ================= rat_herding_node ================= -->
        <mxCell id="ZesqVsjJ1KR3q78cPR1M-4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#e69138;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;span style=&quot;font-size: 48px; font-weight: 400;&quot;&gt;rat_herding_node&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;중앙 PC · 로봇 B 몰이 goal&lt;/span&gt;">
          <mxGeometry height="1570" width="805" x="790" y="4800" as="geometry" />
        </mxCell>
        <mxCell id="cl-rh-cmd" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;command_cb — /fleet/command&lt;/b&gt; 🟢&lt;br&gt;cmd == &apos;HERD&apos; 인 로봇을 B 로 인식 (고정 배정이 아님)&lt;br&gt;create_publisher(PoseStamped, &lt;b&gt;&apos;{robot}/target_pose&apos;&lt;/b&gt;)&lt;br&gt;&lt;i&gt;중앙 PC 에서 도니 절대경로로 발행한다&lt;/i&gt;">
          <mxGeometry height="160" width="760" x="810" y="4910" as="geometry" />
        </mxCell>
        <mxCell id="cl-rh-todo" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=3;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;🔴 event_cb — 몰이 goal 계산 미구현&lt;/b&gt;&lt;br&gt;rat_detected 를 받아 로그만 찍는다&lt;br&gt;self.pose_pub.publish(...) 자리가 비어 있음&lt;br&gt;&lt;br&gt;&lt;b&gt;→ 지금은 로봇 B 가 실제로 쥐를 몰지 않는다&lt;/b&gt;">
          <mxGeometry height="160" width="760" x="810" y="5090" as="geometry" />
        </mxCell>
        <mxCell id="cl-rh-warn" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;🟡 구현할 때 걸릴 지점 2개&lt;/b&gt;&lt;br&gt;· B 미배정(HERD 전) 이면 pose_pub 이 None 이라 이벤트를 그냥 버린다&lt;br&gt;· &lt;b&gt;rat_detected 만 구독&lt;/b&gt; 한다 — 추적 중 갱신되는 쥐 위치(detector 의 target_pose)는 안 본다. 몰이는 최초 1회 좌표로만 계산된다.">
          <mxGeometry height="160" width="760" x="810" y="5270" as="geometry" />
        </mxCell>
        <mxCell id="cl-rh-note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddebf7;strokeColor=#5b9bd5;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="배관은 완성 — 알고리즘만 채우면 루프가 닫힌다.&lt;br&gt;robot_agent.target_cb 가 이미 goToPose 로 주행하므로, 좌표만 계산해 발행하면 로봇 B 가 바로 움직인다.">
          <mxGeometry height="120" width="760" x="810" y="5450" as="geometry" />
        </mxCell>

        <!-- ================= trap_check_node ================= -->
        <mxCell id="cl-tc" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#e69138;strokeWidth=2;fontSize=32;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" value="trap_check_node — 로봇 PC&lt;br&gt;&lt;span style=&quot;font-size: 18px; font-weight: normal;&quot;&gt;detector 가 준 TrapJob 으로만 동작 (지각 안 함) · YOLO 는 detector 만 쓴다&lt;/span&gt;">
          <mxGeometry height="700" width="1400" x="-1210" y="6420" as="geometry" />
        </mxCell>
        <mxCell id="cl-tc-job" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=3;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;job_cb — trap_job (TrapJob)&lt;/b&gt; 🟢&lt;br&gt;phase == &apos;install&apos; → _install&lt;br&gt;phase == &apos;inspect&apos; → _inspect&lt;br&gt;그 외 → 경고 로그&lt;br&gt;&lt;br&gt;&lt;i&gt;TrapJob: phase, hole_x, hole_y, trap_x, trap_y&lt;/i&gt;">
          <mxGeometry height="180" width="430" x="-1190" y="6510" as="geometry" />
        </mxCell>
        <mxCell id="cl-tc-insp" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_inspect — 순수 판정 (주행 없음)&lt;/b&gt; 🟢&lt;br&gt;hypot(hole − trap) ≤ &lt;b&gt;trap_ok_dist 0.15 m&lt;/b&gt; ?&lt;br&gt;→ /fleet/event &lt;b&gt;trap_ok&lt;/b&gt; / &lt;b&gt;trap_bad&lt;/b&gt;&lt;br&gt;&lt;i&gt;detector 가 받아 순찰재개 / 재설치를 정한다&lt;br&gt;db_node 도 같은 이벤트로 trap_installed 를 갱신&lt;/i&gt;">
          <mxGeometry height="180" width="450" x="-740" y="6510" as="geometry" />
        </mxCell>
        <mxCell id="cl-tc-inst" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_install — 사람 호출 + 설치 주행&lt;/b&gt; 🟢&lt;br&gt;beep (cmd_audio AudioNote 1000Hz 1s + speaker-test 폴백)&lt;br&gt;구멍 &lt;b&gt;0.20 m 앞&lt;/b&gt; 으로 이동 → &lt;b&gt;4 s 대기&lt;/b&gt; (사람이 trap 설치)&lt;br&gt;&lt;b&gt;0.6 m 후진&lt;/b&gt; → 2 s → /fleet/event &lt;b&gt;trap_installed&lt;/b&gt;">
          <mxGeometry height="180" width="440" x="-270" y="6510" as="geometry" />
        </mxCell>
        <mxCell id="cl-tc-warn" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;🟡 Nav2 도착 피드백이 여기로 안 온다&lt;/b&gt; — install_wait 4s / retreat_wait 2s 고정시간으로 근사한다. 주행이 느리면 실제 도착 전에 다음 단계로 넘어간다. 게다가 time.sleep 이라 그 동안 이 노드의 콜백이 전부 멈춘다.">
          <mxGeometry height="120" width="890" x="-1190" y="6710" as="geometry" />
        </mxCell>
