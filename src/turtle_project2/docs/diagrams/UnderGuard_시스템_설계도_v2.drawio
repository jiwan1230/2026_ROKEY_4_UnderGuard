        <!-- ================= 제목 · 범례 ================= -->
        <mxCell id="cl-title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17365d;strokeColor=#17365d;fontColor=#ffffff;fontSize=48;fontStyle=1;align=center;verticalAlign=middle;" value="Under-Guard — 2로봇 방역 감시 시스템&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;turtle_project 실제 소스 기준 (2026-08-07) · 코드에 없는 요소는 도면에서 제거함&lt;/font&gt;">
          <mxGeometry height="150" width="2853" x="-1241" y="80" as="geometry" />
        </mxCell>
        <mxCell id="cl-legend" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#17365d;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=10;" value="&lt;b style=&quot;font-size:22px&quot;&gt;범례&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22863a&quot;&gt;■&lt;/font&gt; 초록 — 구현 완료 (self-check 통과, 실제 동작)&lt;br&gt;&lt;font color=&quot;#c53030&quot;&gt;■&lt;/font&gt; 빨강 — 미구현 스텁 (코드가 pass / 로그만)&lt;br&gt;&lt;font color=&quot;#b7791f&quot;&gt;■&lt;/font&gt; 노랑 — 알려진 한계·주의 (동작하지만 취약)&lt;br&gt;&lt;font color=&quot;#2563eb&quot;&gt;■&lt;/font&gt; 파랑 굵은 테두리 — 상태기계의 state&lt;br&gt;&lt;br&gt;&lt;b&gt;미구현은 2개뿐:&lt;/b&gt; webcam_node.tick, rat_herding 몰이 goal 계산">
          <mxGeometry height="290" width="1300" x="-1241" y="270" as="geometry" />
        </mxCell>
        <mxCell id="cl-topics" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#4a86e8;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=10;" value="&lt;b style=&quot;font-size:22px&quot;&gt;배선 규칙 (fleet_msg.py 포맷)&lt;/b&gt;&lt;br&gt;노드 간 통신은 String 토픽 3개로만: &lt;b&gt;/fleet/status&lt;/b&gt; &quot;robot4:PATROLLING:85&quot; · &lt;b&gt;/fleet/command&lt;/b&gt; &quot;robot6:UNDOCK&quot; · &lt;b&gt;/fleet/event&lt;/b&gt; &quot;rat_detected:1.20:3.40&quot;&lt;br&gt;&lt;b&gt;target_pose&lt;/b&gt;(PoseStamped)는 로봇당 하나 — detector·trap_check·rat_herding이 발행하고 &lt;b&gt;robot_agent만 구독&lt;/b&gt; = 로봇당 Nav2 주인 1개&lt;br&gt;로봇별 토픽은 상대경로 — 실행 때 &lt;b&gt;__ns:=/robot4&lt;/b&gt; 를 걸면 /robot4/... 로 맞춰진다 (네임스페이스 없이 띄우면 robot_id가 빈 문자열이라 모든 명령을 무시)">
          <mxGeometry height="290" width="1490" x="79" y="270" as="geometry" />
        </mxCell>

