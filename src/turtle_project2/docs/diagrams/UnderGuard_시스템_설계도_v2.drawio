        <!-- ================= camera_node (robot6, PC2) ================= -->
        <mxCell id="v4Ri3YPVRutm3d3QiX_--1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#5b9bd5;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;camera_node /robot6&lt;/b&gt;&lt;br/&gt;SUB 3 topics:&lt;br/&gt;• oakd/rgb/image_raw/compressed&lt;br/&gt;• oakd/stereo/image_raw/compressedDepth&lt;br/&gt;• oakd/stereo/camera_info&lt;br/&gt;QoS: sensor_data / BestEffort">
          <mxGeometry height="110" width="270" x="6280" y="832.5" as="geometry" />
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;ApproximateTimeSynchronizer&lt;/b&gt; 🟢&lt;br/&gt;queue_size=10 · slop=0.10 s&lt;br/&gt;RGB / aligned Depth / CameraInfo 의 Header.stamp 차이를 검사해 동일 관측 시점 bundle 을 만든다.&lt;br/&gt;&lt;br/&gt;PC1 robot4 인스턴스와 코드 동일 (namespace 만 다름)">
          <mxGeometry height="150" width="345" x="6280" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--4" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" value="max(stamp) − min(stamp) ≤ 0.10 s&lt;br/&gt;AND 3개 입력이 모두 존재하는가?">
          <mxGeometry height="180" width="240" x="6720" y="870" as="geometry" />
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#999999;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;NO → tuple 폐기&lt;/b&gt;&lt;br/&gt;message_filters 가 큐에서 버린다&lt;br/&gt;(진단 토픽 없음)&lt;br/&gt;다음 입력 대기">
          <mxGeometry height="95" width="190" x="6745" y="1155" as="geometry" />
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--6" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;YES → 동기화 3종 재발행&lt;/b&gt;&lt;br&gt;/robot6/synced/rgb&lt;br&gt;/robot6/synced/depth&lt;br&gt;/robot6/synced/camera_info">
          <mxGeometry height="110" width="345" x="6980" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--2" edge="1" parent="1" source="Axxf3i6UiLeMtmhwf-ec-1" target="v4Ri3YPVRutm3d3QiX_--1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#2563eb;fontColor=#2563eb;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" value="3 sensor topics · BestEffort">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6190" y="875" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--8" edge="1" parent="1" source="v4Ri3YPVRutm3d3QiX_--1" target="v4Ri3YPVRutm3d3QiX_--3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#2563eb;fontColor=#2563eb;fontSize=8;labelBackgroundColor=#ffffff;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" value="robot6 triple stream">
          <mxGeometry relative="1" x="-0.1873" as="geometry"><mxPoint as="offset" /><Array as="points"><mxPoint x="6600" y="887.5" /><mxPoint x="6600" y="980" /><mxPoint x="6452.5" y="980" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="v4Ri3YPVRutm3d3QiX_--7" edge="1" parent="1" source="v4Ri3YPVRutm3d3QiX_--4" target="v4Ri3YPVRutm3d3QiX_--6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#38761d;fontColor=#38761d;fontSize=8;labelBackgroundColor=#ffffff;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="&lt;b&gt;yes&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7152.52" y="959.97" /></Array></mxGeometry>
        </mxCell>

        <!-- ================= PC2 robot6 앱 노드 ================= -->
        <mxCell id="cl-pc2-apps" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#e69138;strokeWidth=2;fontSize=32;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" value="robot6 앱 노드 — PC1 의 robot4 구성과 코드 동일 (__ns:=/robot6 만 다름)">
          <mxGeometry height="900" width="2540" x="5990" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="cl-pc2-det" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;detector_node&lt;/b&gt; 🟢&lt;br&gt;synced/rgb·depth·camera_info 구독&lt;br&gt;YOLO(best.pt) opening·rat·trap 감지&lt;br&gt;opening 상태기계 + RatTracker&lt;br&gt;→ target_pose · trap_job · /fleet/event&lt;br&gt;&lt;br&gt;&lt;i&gt;robot_id = 'robot6' (get_namespace 에서)&lt;/i&gt;">
          <mxGeometry height="260" width="580" x="6640" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="cl-pc2-cam" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;camera_node&lt;/b&gt; 🟢&lt;br&gt;위 sync 파이프 (좌측 상세)&lt;br&gt;원본 3종 → synced/ 3종 재발행">
          <mxGeometry height="260" width="580" x="6020" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="cl-pc2-trap" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;trap_check_node&lt;/b&gt; 🟢&lt;br&gt;trap_job (TrapJob) 구독&lt;br&gt;install: beep + 접근·후진 주행&lt;br&gt;inspect: 구멍↔trap ≤ 0.15m 판정&lt;br&gt;→ /fleet/event trap_ok·bad·installed">
          <mxGeometry height="260" width="580" x="7260" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="cl-pc2-agent" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;robot_agent&lt;/b&gt; 🟢&lt;br&gt;namespace:=robot6 파라미터&lt;br&gt;/fleet/command 에서 robot6 명령만&lt;br&gt;FollowWaypoints 순찰 · dock/undock&lt;br&gt;target_pose → goToPose&lt;br&gt;→ /fleet/status robot6:STATE:배터리">
          <mxGeometry height="260" width="580" x="7880" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="cl-pc2-note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=16;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;PC2 에는 중앙 노드가 없다&lt;/b&gt; — central_node · db_node · rat_herding_node · webcam_node 는 PC1 에만 뜬다. 로봇당 Nav2 주인이 1개여야 하듯, 중앙 조율자도 fleet 전체에 1개다.&lt;br&gt;discovery-server 네트워킹이라 /fleet/* 토픽은 PC 위치와 무관하게 오간다 — PC2 의 robot6 detector 가 쏜 rat_detected 도 PC1 의 central 이 그대로 받는다.&lt;br&gt;&lt;br&gt;&lt;b&gt;기동 순서&lt;/b&gt; (docs/run.md): ① robot_bringup.launch.py (localization → active 확인 → navigation) ② RViz 2D Pose Estimate 로 초기 위치 지정 (AMCL 이 기억 못 해 매번 필요) ③ 앱 노드 실행">
          <mxGeometry height="400" width="2440" x="6020" y="1810" as="geometry" />
        </mxCell>

        <!-- ================= CentralNode ================= -->
        <mxCell id="NWHLcj35TzfSmlRE1Hsn-5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F5F6;strokeColor=#8e7cc3;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacing=6;" value="&lt;font style=&quot;font-size: 48px;&quot;&gt;central_node — 순찰 교대 · 쥐대응 역할배정 (중앙 PC 1개)&lt;/font&gt;">
          <mxGeometry height="1240" width="2740" x="-1184.5" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-status" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;status_cb&lt;/b&gt; — /fleet/status 수신 (robot:state:battery) 🟢&lt;br&gt;state == PATROLLING → self.patroller 갱신, waking 해제&lt;br&gt;rat_mode 중이면 여기서 리턴 — 쥐대응 중엔 역할 고정, 조율 개입 안 함">
          <mxGeometry height="120" width="740" x="-1180" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-next" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;교대 — next_command(state)&lt;/b&gt; 🟢&lt;br&gt;DOCKED → 상대 로봇에게 UNDOCK&lt;br&gt;&lt;br&gt;가드 3개:&lt;br&gt;• prev is None(첫 status)은 전이가 아님 — 둘 다 DOCKED 로 시작할 때 서로를 깨워 둘 다 순찰하는 사고 방지&lt;br&gt;• prev[0] != state 인 실제 전이일 때만&lt;br&gt;• 이미 순찰 중인 로봇이 있으면 안 깨움">
          <mxGeometry height="200" width="460" x="-1180" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-cov" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_ensure_coverage / coverage_action&lt;/b&gt; 🟢&lt;br&gt;항상 최소 1대 순찰하도록 보장 (부트스트랩·복구)&lt;br&gt;&lt;br&gt;busy = PATROLLING·TRACKING·HERDING·RETURNING·UNDOCKING&lt;br&gt;waking 없고 아무도 busy 아니면&lt;br&gt;DOCKED/IDLE 중 한 대를 골라 UNDOCK&lt;br&gt;&lt;i&gt;RETURNING 도 busy — 교대 진행 중엔 개입 안 함&lt;/i&gt;">
          <mxGeometry height="200" width="460" x="-1180" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-event" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;event_cb&lt;/b&gt; — /fleet/event 🟢&lt;br&gt;rat_detected → _on_rat&lt;br&gt;rat_captured → _end_rat(caught=True)&lt;br&gt;rat_lost → _end_rat(caught=False)&lt;br&gt;&lt;br&gt;&lt;i&gt;opening_confirmed · trap_installed · trap_ok · trap_bad 는 로그만 — 방역 세부는 로봇 로컬(detector·db)에서 처리하고 central 은 PATROLLING 으로만 안다&lt;/i&gt;">
          <mxGeometry height="200" width="490" x="60" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-onrat" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_on_rat — assign_roles(patroller, robots)&lt;/b&gt; 🟢&lt;br&gt;순찰 중이던 로봇 = &lt;b&gt;A (TRACK, 추적)&lt;/b&gt; / 나머지 = &lt;b&gt;B (HERD, 몰이)&lt;/b&gt;&lt;br&gt;robot4·robot6 어느 쪽이든 무관 — 고정 배정이 아니라 런타임 배정&lt;br&gt;rat_mode 로 첫 트리거만 수용 (쥐는 여러 프레임 연속 감지됨)&lt;br&gt;배정 실패(순찰 로봇 없음 / 로봇 1대) → 경고 후 무시">
          <mxGeometry height="170" width="880" x="-340" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-endrat" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_end_rat(caught) — 포획/놓침 공통 종료&lt;/b&gt; 🟢&lt;br&gt;A → PATROL (순찰 복귀) / B → DOCK (도킹 복귀)&lt;br&gt;rat_caught 에 결과 보관 (포획 성공 / 놓침)&lt;br&gt;rat_mode 아니면 무시 — 중복 이벤트 방어&lt;br&gt;→ 다시 &apos;한 대씩 순찰&apos; 상태로">
          <mxGeometry height="170" width="325" x="1215" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-e1" edge="1" parent="1" source="cl-cn-status" target="cl-cn-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" value="상태 전이">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-e2" edge="1" parent="1" source="cl-cn-next" target="cl-cn-cov" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" value="전이 아니면">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-e3" edge="1" parent="1" source="cl-cn-event" target="cl-cn-onrat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" value="rat_detected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-cn-e4" edge="1" parent="1" source="cl-cn-event" target="cl-cn-endrat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" value="rat_captured / rat_lost">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="1340" /><mxPoint x="1600" y="2005" /></Array></mxGeometry>
        </mxCell>

        <!-- 5개 모드 상자 -->
        <mxCell id="RLcfunM6EJidx0AuIkmK-10" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacing=6;" value="&lt;b&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;PATROL&lt;/font&gt;&lt;/b&gt;">
          <mxGeometry height="310" width="745" x="-700" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-pat1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;명령: robotX:PATROL&lt;/b&gt;&lt;br&gt;robot_agent.start_patrol&lt;br&gt;waypoints YAML (patrol_waypoints.yaml)&lt;br&gt;→ nav.followWaypoints(poses)&lt;br&gt;한 바퀴 끝나면 patrol_tick 이 _send_lap 으로 재시작 = 무한 순찰">
          <mxGeometry height="180" width="350" x="-680" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-pat2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;보고: PATROLLING&lt;/b&gt;&lt;br&gt;_send_lap 에서만 방송 (goal 발행 성공 후)&lt;br&gt;→ central.patroller 갱신&lt;br&gt;&lt;br&gt;이 동안 detector 는 SEARCHING 으로 opening·rat 을 찾는다">
          <mxGeometry height="180" width="340" x="-310" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="y0fYnWds9ogXdXYXN07V-5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacing=6;" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;&lt;b&gt;TRACK (로봇 A)&lt;/b&gt;&lt;/font&gt;">
          <mxGeometry height="310" width="680" x="570" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-trk1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;명령: robotA:TRACK&lt;/b&gt;&lt;br&gt;detector.tracking = True&lt;br&gt;RatTracker.start(now)&lt;br&gt;robot_agent: stop_patrol, state=TRACKING&lt;br&gt;→ 쥐 위치로 target_pose 1 Hz 재발행">
          <mxGeometry height="180" width="320" x="590" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-trk2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;종료 조건 (RatTracker)&lt;/b&gt;&lt;br&gt;포획: 0.3 m 반경 안에 10 s 체류&lt;br&gt;놓침: 5 s 미검출 (lost_tick 1 s 폴링)&lt;br&gt;→ rat_captured / rat_lost 발행&lt;br&gt;&lt;i&gt;관측 0회여도 start 기준 5s 뒤 놓침 — 영구 고착 방지&lt;/i&gt;">
          <mxGeometry height="180" width="300" x="930" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="fkapCajKWG6HI9sVUpWm-3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacing=6;" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;&lt;b&gt;HERD (로봇 B)&lt;/b&gt;&lt;/font&gt;">
          <mxGeometry height="310" width="680" x="570" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-herd1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;명령: robotB:HERD&lt;/b&gt;&lt;br&gt;robot_agent: stop_patrol, state=HERDING&lt;br&gt;도크에 붙어 있었으면 &lt;b&gt;먼저 언도킹&lt;/b&gt;&lt;br&gt;(after_undock=None → 완료 후 goal 대기)&lt;br&gt;&lt;i&gt;안 그러면 몸은 도크에 붙은 채 상태만 HERDING&lt;/i&gt;">
          <mxGeometry height="210" width="320" x="590" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-herd2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;🔴 rat_herding_node&lt;/b&gt;&lt;br&gt;HERD 대상 로봇을 B 로 인식하고&lt;br&gt;{B}/target_pose 퍼블리셔는 만들지만&lt;br&gt;&lt;b&gt;몰이 goal 계산이 미구현&lt;/b&gt; (로그만)&lt;br&gt;&lt;br&gt;→ 지금은 B 가 실제로 몰지 않는다">
          <mxGeometry height="210" width="300" x="930" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="fkapCajKWG6HI9sVUpWm-2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacing=6;" value="&lt;span style=&quot;font-size: 36px;&quot;&gt;&lt;b&gt;DOCK&lt;/b&gt;&lt;/span&gt;">
          <mxGeometry height="310" width="680" x="-150" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-dock1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;진입: robotX:DOCK 또는 배터리 &amp;lt; 40%&lt;/b&gt;&lt;br&gt;state = RETURNING&lt;br&gt;도크 &apos;앞&apos; 좌표 (dock_x, dock_y, dock_yaw_deg) 로 goToPose&lt;br&gt;&lt;i&gt;현장마다 실측 필요 — yaw 는 도크를 바라보는 방향&lt;/i&gt;&lt;br&gt;도착 → dock_send_goal (Create3 IR 정밀 도킹)">
          <mxGeometry height="210" width="320" x="-130" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-dock2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;완료 판정 (_dock_tick)&lt;/b&gt;&lt;br&gt;isDockComplete 는 &lt;b&gt;실패한 goal 도 &apos;완료&apos;&lt;/b&gt; 로 주므로&lt;br&gt;dock 센서 nav.is_docked 로 재확인&lt;br&gt;성공 → DOCKED ★ central 교대 트리거&lt;br&gt;실패 → IDLE (실패를 DOCKED 로 축약 금지)">
          <mxGeometry height="210" width="300" x="210" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="fkapCajKWG6HI9sVUpWm-1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacing=6;" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;&lt;b&gt;UNDOCK&lt;/b&gt;&lt;/font&gt;">
          <mxGeometry height="310" width="680" x="-1030" y="1850" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-und1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;명령: robotX:UNDOCK&lt;/b&gt;&lt;br&gt;state = UNDOCKING (즉시 PATROLLING 아님)&lt;br&gt;after_undock = &apos;PATROL&apos;&lt;br&gt;nav.undock_send_goal() — 논블로킹">
          <mxGeometry height="180" width="320" x="-1010" y="1930" as="geometry" />
        </mxCell>
        <mxCell id="cl-m-und2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;_dock_tick UNDOCK 단계&lt;/b&gt;&lt;br&gt;isUndockComplete → after_undock 분기&lt;br&gt;&apos;PATROL&apos; → 순찰 시작&lt;br&gt;&apos;DOCK&apos; → 바로 복귀 도킹&lt;br&gt;None → target_pose 대기 (추적/몰이)&lt;br&gt;&lt;i&gt;도크에 붙은 채로는 Nav2 goal 이 안 먹혀 반드시 선행&lt;/i&gt;">
          <mxGeometry height="180" width="300" x="-670" y="1930" as="geometry" />
        </mxCell>
        <!-- ================= detector_node ================= -->
        <mxCell id="v4Ri3YPVRutm3d3QiX_--26" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#e69138;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;detector_node — YOLO 클래스 게이트 · Depth 3D 측위 · 관측 라우팅&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot;&gt;로봇 PC에서 __ns:=/robot4 로 실행 · YOLO를 쓰는 유일한 노드 (trap_check는 좌표만 받는다)&lt;/font&gt;&lt;/b&gt;">
          <mxGeometry height="2030" width="1400" x="-1200" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="QpyxGBAFvDB_q9pLpngH-2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;detector 자체 ApproximateTimeSynchronizer&lt;/b&gt; 🟢&lt;br/&gt;queue_size=10 · slop=0.10 s&lt;br/&gt;camera_node 가 재발행한 &lt;b&gt;synced/rgb · synced/depth · synced/camera_info&lt;/b&gt; 3종을 다시 stamp 로 짝맞춘다.&lt;br/&gt;camera_info 도 함께 sync — K(내부 파라미터)를 같은 프레임으로 받기 위해.">
          <mxGeometry height="130" width="345" x="-670" y="2629.94" as="geometry" />
        </mxCell>
        <mxCell id="QpyxGBAFvDB_q9pLpngH-3" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" value="max(stamp) − min(stamp) ≤ 0.10 s&lt;br/&gt;AND 3개 입력이 모두 존재하는가?">
          <mxGeometry height="180" width="240" x="-617.5" y="2889.94" as="geometry" />
        </mxCell>
        <mxCell id="QpyxGBAFvDB_q9pLpngH-4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#999999;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;NO → tuple 폐기&lt;/b&gt;&lt;br/&gt;불완전/오래된 frame 은 처리하지 않음&lt;br/&gt;message_filters 큐에서 조용히 드롭&lt;br/&gt;다음 입력 대기">
          <mxGeometry height="95" width="190" x="-950" y="2719.94" as="geometry" />
        </mxCell>
        <mxCell id="QpyxGBAFvDB_q9pLpngH-5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=6;arcSize=13;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;synced_cb&lt;/b&gt;&lt;/div&gt;&lt;b&gt;상태 게이트가 먼저&lt;/b&gt; — APPROACHING 이면 _check_arrival 만 하고 리턴, QUERYING·AWAIT_TRAP 이면 그냥 리턴 (지각 불필요)&lt;br&gt;그 외에만 K 저장 → 압축 해제(cv_bridge / decode_depth) → &lt;b&gt;YOLO 1회 추론&lt;/b&gt; → 클래스별 라우팅">
          <mxGeometry height="112" width="345" x="-670" y="3159.94" as="geometry" />
        </mxCell>
        <mxCell id="RLcfunM6EJidx0AuIkmK-1" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" value="names[cls] == &lt;b&gt;&quot;rat&quot;&lt;/b&gt; ?&lt;br&gt;&lt;i&gt;(상태 무관, 매 프레임)&lt;/i&gt;">
          <mxGeometry height="160" width="190" x="-1170" y="3283.75" as="geometry" />
        </mxCell>
        <mxCell id="RLcfunM6EJidx0AuIkmK-2" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" value="names[cls] == &lt;b&gt;&quot;opening&quot;&lt;/b&gt; ?&lt;br&gt;&lt;i&gt;SEARCHING · VERIFYING 에서만&lt;/i&gt;">
          <mxGeometry height="160" width="255" x="-890" y="3283.75" as="geometry" />
        </mxCell>
        <mxCell id="RLcfunM6EJidx0AuIkmK-4" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" value="names[cls] == &lt;b&gt;&quot;trap&quot;&lt;/b&gt; ?&lt;br&gt;&lt;i&gt;INSPECTING 에서만&lt;/i&gt;">
          <mxGeometry height="160" width="355" x="-580" y="3283.75" as="geometry" />
        </mxCell>
        <mxCell id="RLcfunM6EJidx0AuIkmK-3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;_pick(result, cls_name, img_shape)&lt;/b&gt;&lt;br&gt;신뢰도 문턱은 &lt;b&gt;conf 파라미터 하나(기본 0.6)&lt;/b&gt; — YOLO 호출 시 한 번에 적용, 클래스별 문턱·면적 필터 없음&lt;br&gt;같은 클래스 박스가 여럿이면 &lt;b&gt;화면 중앙(u ≈ w/2)에 가장 가까운 것 1개&lt;/b&gt; 만 고른다&lt;br&gt;&lt;br&gt;&lt;i&gt;모델 클래스는 opening · rat · trap 3개&lt;/i&gt;">
          <mxGeometry height="160" width="365" x="-200" y="3283.75" as="geometry" />
        </mxCell>
        <mxCell id="x4redIiIMa9jU7bzmFlu-1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;_box_to_map — bbox → map 좌표&lt;/b&gt; 🟢&lt;br/&gt;1. bbox 중심 (u,v)&lt;br/&gt;2. to_depth_px — RGB↔depth 해상도 비례 매핑&lt;br/&gt;3. depth_at — 11×11(PATCH=5) 유효값 &lt;b&gt;중앙값&lt;/b&gt; → m&lt;br/&gt;4. deproject(u,v,z,K) → 카메라 광학 XYZ&lt;br/&gt;5. PointStamped(depth frame) → tf.transform(&apos;map&apos;)&lt;br/&gt;6. → (x, y) · 실패 시 None (다음 프레임 재시도)">
          <mxGeometry height="150" width="310" x="-1190" y="3610" as="geometry" />
        </mxCell>
        <mxCell id="Bt-omwzy2xqqBgIjLX3l-1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;_box_to_map (opening 경로)&lt;/b&gt; 🟢&lt;br/&gt;위와 같은 함수 — 구멍 bbox 중심의 map 좌표&lt;br/&gt;z 가 무효(0)면 None → 이 프레임 스킵&lt;br/&gt;TF 실패도 None → 순찰 유지한 채 재시도&lt;br/&gt;&lt;i&gt;stamp 0 = 최신 TF 사용&lt;/i&gt;">
          <mxGeometry height="132.5" width="310" x="-917.5" y="3790" as="geometry" />
        </mxCell>
        <mxCell id="x4redIiIMa9jU7bzmFlu-2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e5;strokeColor=#70ad47;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;_start_approach&lt;/b&gt; 🟢&lt;br&gt;robot_xy() 로 로봇 현재 위치 (TF map→base_link)&lt;br&gt;approach_point(dx, dy, &lt;b&gt;approach_dist 0.5m&lt;/b&gt;) → 구멍 앞 지점&lt;br&gt;map 절대좌표로 환산 후 &lt;b&gt;target_pose 발행&lt;/b&gt;&lt;br&gt;goal 확정 &lt;b&gt;후에&lt;/b&gt; patrol_hold=True (TF 실패 시 순찰만 멈추는 사고 방지)&lt;br&gt;&lt;b&gt;state = APPROACHING&lt;/b&gt; (이미 0.5m 안이면 그때만 바로 VERIFYING)">
          <mxGeometry height="180" width="420" x="-1030" y="3960" as="geometry" />
        </mxCell>
