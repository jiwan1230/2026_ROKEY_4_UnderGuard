          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-e-s8" edge="1" parent="1" source="cl-d-exists" target="cl-s-inspect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;fontSize=14;labelBackgroundColor=#ffffff;" value="YES — 기존">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-e-s9" edge="1" parent="1" source="cl-s-verify" target="cl-a-verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cl-e-s10" edge="1" parent="1" source="cl-s-inspect" target="cl-a-inspect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#2563eb;">
          <mxGeometry relative="1" as="geometry" />
